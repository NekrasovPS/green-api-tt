<file path="src/api/chatApi.ts">
import { apiClient } from "./apiClient";

export const chatApi = {
  /**
   * Отправка текстового сообщения через инстанс GREEN-API
   * @param chatId - Номер телефона (например, "79527914534") или числовой ID Telegram
   */
  sendMessage: async (
    idInstance: string,
    apiTokenInstance: string,
    chatId: string,
    message: string,
  ) => {
    const cleanChatId = chatId.trim();

    // Если передан номер телефона (начинается на 7 или 8 и имеет длину 11 и более символов)
    // то принудительно добавляем суффикс @c.us, как требует GREEN-API для Telegram-инстансов.
    const isPhoneNumber =
      (cleanChatId.startsWith("7") || cleanChatId.startsWith("8")) &&
      cleanChatId.length >= 11;

    const formattedChatId = isPhoneNumber
      ? cleanChatId.includes("@")
        ? cleanChatId
        : `${cleanChatId}@c.us`
      : cleanChatId; // Если это чистый внутренний Telegram ID, оставляем как есть

    const response = await apiClient.post(
      `/waInstance${idInstance}/sendMessage/${apiTokenInstance}`,
      {
        chatId: formattedChatId,
        message: message,
      },
    );

    return response.data;
  },

  /**
   * Получить одно входящее уведомление из очереди сервера GREEN-API
   */
  receiveNotification: async (idInstance: string, apiTokenInstance: string) => {
    const response = await apiClient.get(
      `/waInstance${idInstance}/receiveNotification/${apiTokenInstance}`,
    );
    return response.data;
  },

  /**
   * Удалить обработанное уведомление из очереди, чтобы оно не прилетало повторно
   */
  deleteNotification: async (
    idInstance: string,
    apiTokenInstance: string,
    receiptId: number,
  ) => {
    const response = await apiClient.delete(
      `/waInstance${idInstance}/deleteNotification/${apiTokenInstance}/${receiptId}`,
    );
    return response.data;
  },
};
