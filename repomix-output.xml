<file path="src/components/ChatMessages/ChatMessages.tsx">
import { useState } from "react";
import { useChatStore } from "../../store/chatStore";
import { useAuthStore } from "../../store/authStore";
import { chatApi } from "../../api/chatApi";
import styles from "./ChatMessages.module.scss";

function ChatMessages() {
  const [text, setText] = useState("");

  // 1. Достаем ID активного чата и функцию отправки из Zustand стора чата
  const activeChatId = useChatStore((state) => state.activeChatId);
  const addMessage = useChatStore((state) => state.addMessage);

  // 2. Вариант А: Достаем стабильный объект всех сообщений для исключения бесконечного цикла
  const messages = useChatStore((state) => state.messages);

  // 3. Безопасно вытаскиваем массив сообщений для выбранного номера телефона/ID
  const chatHistory = activeChatId ? messages[activeChatId] || [] : [];

  // 4. Достаем ключи авторизации из стора авторизации для выполнения сетевых запросов
  const idInstance = useAuthStore((state) => state.idInstance);
  const apiTokenInstance = useAuthStore((state) => state.apiTokenInstance);

  const handleSend = async (event: React.FormEvent<HTMLFormElement>) => {
    event.preventDefault();

    // Если поле пустое или чат не выбран — ничего не делаем
    if (text.trim() === "" || !activeChatId) return;

    const messageText = text;
    setText(""); // Мгновенно очищаем инпут для отзывчивого UX

    // А. Сначала сохраняем сообщение в локальный Zustand стор (оно сразу отобразится справа)
    addMessage(activeChatId, messageText, "me");

    // Б. Асинхронно отправляем сообщение на сервер GREEN-API
    try {
      await chatApi.sendMessage(
        idInstance,
        apiTokenInstance,
        activeChatId,
        messageText,
      );
      console.log("Сообщение успешно отправлено на сервер GREEN-API!");
    } catch (error) {
      // Мягко перехватываем ошибку (например, превышение квоты тарифа),
      // чтобы приложение не ломалось, а локальный чат продолжал работать
      console.warn(
        "API временно недоступно (превышена квота), но сообщение успешно добавлено локально:",
        error,
      );
    }
  };

  // Заглушка: если пользователь еще не кликнул ни на один контакт слева
  if (!activeChatId) {
    return (
      <div className={styles.messagesEmpty}>
        <p>Выберите контакт из списка слева, чтобы начать переписку.</p>
      </div>
    );
  }

  return (
    <div className={styles.messages}>
      {/* Шапка текущего активного чата */}
      <div className={styles.messages__header}>
        <h3>Чат с ID: {activeChatId}</h3>
      </div>

      {/* Зона истории переписки */}
      <div className={styles.messages__history}>
        {/* .toReversed() разворачивает копию массива для верстки снизу вверх (column-reverse) */}
        {chatHistory.toReversed().map((msg) => (
          <div
            key={msg.id}
            className={`${styles.message} ${
              msg.sender === "me"
                ? styles.message_outgoing
                : styles.message_incoming
            }`}
          >
            <p className={styles.message__text}>{msg.text}</p>
            <span className={styles.message__time}>{msg.time}</span>
          </div>
        ))}
      </div>

      {/* Семантическая форма ввода текста */}
      <form onSubmit={handleSend} className={styles.messages__text}>
        <input
          placeholder="Введите текст"
          type="text"
          value={text}
          onChange={(e) => setText(e.target.value)}
        />
        <button type="submit">Отправить</button>
      </form>
    </div>
  );
}

export default ChatMessages;
</file>

